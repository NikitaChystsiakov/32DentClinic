# Apache-настройки для статического сайта (out/ → корень хостинга).
# Файл попадает в out/ из public/ при сборке.

# Страница «не найдено» из экспорта Next вместо стандартной страницы Apache.
ErrorDocument 404 /404.html

# Кодировка текстовых файлов (в т. ч. .txt-payload'ов Next для клиентских переходов).
AddDefaultCharset UTF-8

# Сжатие текстовых ответов, если модуль доступен на хостинге.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml application/javascript application/json image/svg+xml
</IfModule>

# Файлы Next в /_next/static/ имеют хэш в имени — их можно кешировать навсегда.
<IfModule mod_headers.c>
  <If "%{REQUEST_URI} =~ m#^/_next/static/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
</IfModule>
