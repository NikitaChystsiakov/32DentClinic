# Конфиг с токенами и вспомогательный код не должны отдаваться напрямую даже
# если PHP на хостинге вдруг отключён — только booking.php подключает их
# через require. Снаружи доступен один booking.php.
<FilesMatch "^(config\.php|config\.example\.php|booking-transport\.php)$">
  Require all denied
</FilesMatch>
